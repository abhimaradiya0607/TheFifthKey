<%layout('/layouts/boilerplate')%>
<script>
    let mapToken="<%=process.env.MAP_TOKEN%>"
    const coordinates=<%-JSON.stringify(listing.geometry.coordinates)%>;
</script> 

<div class="container py-5">

  <!-- Title -->
  <div class="row mb-3">
    <div class="col-lg-8 offset-lg-2">
      <h1 class="show-title"><%=listing.title%></h1>
    </div>
  </div>

  <!-- Listing Card -->
  <div class="row mb-4">
    <div class="col-lg-8 offset-lg-2">
      <div class="show-card-wrapper">
        <img src="<%=listing.image.url%>" class="show-main-img" onerror="this.src='/images/default-img.jpg';">
        <div class="show-details">
          <p class="show-description">
            Owned By <b><i><%=listing.owner.username%></i></b>
          </p>
          <p class="show-description"><%=listing.description%></p>
          <div class="show-meta">
            <span class="show-price">&#8377;<%=listing.price.toLocaleString("en-IN")%> <span class="per-night">/ night</span></span>
            <span class="show-location">
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16">
                <path d="M8 16s6-5.686 6-10A6 6 0 0 0 2 6c0 4.314 6 10 6 10zm0-7a3 3 0 1 1 0-6 3 3 0 0 1 0 6z"/>
              </svg>
              <%=listing.location%>, <%=listing.country%>
            </span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Action Buttons -->
   <%if(currUser && listing.owner._id.equals(currUser._id)){%>
  <div class="row mb-4">
    <div class="col-lg-8 offset-lg-2">
      <div class="action-btns">
        <a href="/listing/<%=listing._id%>/edit" class="btn-edit">
          <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" fill="currentColor" viewBox="0 0 16 16">
            <path d="M12.146.146a.5.5 0 0 1 .708 0l3 3a.5.5 0 0 1 0 .708l-10 10a.5.5 0 0 1-.168.11l-5 2a.5.5 0 0 1-.65-.65l2-5a.5.5 0 0 1 .11-.168l10-10zM11.207 2.5 13.5 4.793 14.793 3.5 12.5 1.207zm1.586 3L10.5 3.207 4 9.707V10h.5a.5.5 0 0 1 .5.5v.5h.5a.5.5 0 0 1 .5.5v.5h.293zm-9.761 5.175-.106.106-1.528 3.821 3.821-1.528.106-.106A.5.5 0 0 1 5 12.5V12h-.5a.5.5 0 0 1-.5-.5V11h-.5a.5.5 0 0 1-.468-.325z"/>
          </svg>
          Edit Listing
        </a>
        <form method="post" action="/listing/<%=listing._id%>?_method=DELETE">
          <button type="submit" class="btn-delete">
            <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" fill="currentColor" viewBox="0 0 16 16">
              <path d="M5.5 5.5A.5.5 0 0 1 6 6v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5zm2.5 0a.5.5 0 0 1 .5.5v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5zm3 .5a.5.5 0 0 0-1 0v6a.5.5 0 0 0 1 0V6z"/>
              <path fill-rule="evenodd" d="M14.5 3a1 1 0 0 1-1 1H13v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4h-.5a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1H6a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1h3.5a1 1 0 0 1 1 1v1zM4.118 4 4 4.059V13a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V4.059L11.882 4H4.118zM2.5 3V2h11v1h-11z"/>
            </svg>
            Delete Listing
          </button>
        </form>
      </div>
    </div>
  </div>
  <%}%>

  <div class="row">
    <div class="col-lg-8 offset-lg-2">
      <hr class="section-divider">
    </div>
  </div>

  <!-- Review Form -->
   <%if(currUser){%>
  <div class="row mt-4">
    <div class="col-lg-8 offset-lg-2">
      <div class="review-section">
        <h4 class="review-title">Leave a Review</h4>

        <form method="post" action="/listing/<%=listing._id%>/reviews" novalidate class="needs-validation">

          <!-- Star Rating -->
          <div class="mb-4">
            <label class="review-label">Your Rating</label>
            <fieldset class="starability-slot">
              <input type="radio" 
              id="no-rate" 
              class="input-no-rate" 
              name="review[rating]" 
              value="1" 
              checked 
              aria-label="No rating." />

              <legend>First rating:</legend>
              <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1" checked aria-label="No rating." />
              <input type="radio" id="first-rate1" name="review[rating]" value="1" />
              <label for="first-rate1" title="Terrible">1 star</label>
              <input type="radio" id="first-rate2" name="review[rating]" value="2" />
              <label for="first-rate2" title="Not good">2 stars</label>
              <input type="radio" id="first-rate3" name="review[rating]" value="3" />
              <label for="first-rate3" title="Average">3 stars</label>
              <input type="radio" id="first-rate4" name="review[rating]" value="4" />
              <label for="first-rate4" title="Very good">4 stars</label>
              <input type="radio" id="first-rate5" name="review[rating]" value="5" />
              <label for="first-rate5" title="Amazing">5 stars</label>
            </fieldset>
            <div id="ratingError" style="display:none; color:#dc3545; font-size:0.875rem; margin-top:0.4rem;">
              Please select a rating.
            </div>
          </div>
       

          <!-- Comment -->
          <div class="mb-4">
            <label class="review-label" for="comment">Your Comment</label>
            <textarea
              required
              name="review[comment]"
              id="comment"
              rows="4"
              class="review-textarea"
              placeholder="Share your experience with this property..."></textarea>
            <div class="invalid-feedback">Please add some comments for review.</div>
          </div>

          <button type="submit" class="btn-submit">Submit Review</button>

        </form>
      </div>
    </div>
  </div>
  <%}%>

  <!-- All Reviews -->
   <%if(listing.reviews.length>0){%>
  <div class="row mt-4">
    <div class="col-lg-8 offset-lg-2">

      <div style="display:flex; align-items:baseline; gap:10px; margin-bottom:1rem;">
        <h4 style="margin:0;">All Reviews</h4>
        <span style="color:#888; font-size:0.875rem;"><%= listing.reviews.length %> review<%= listing.reviews.length !== 1 ? 's' : '' %></span>
      </div>

      <div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(260px,1fr)); gap:16px;">
        <% for(let review of listing.reviews) { %>
        <div class="review-card">

          <!-- Stars -->
          <b><i>@<%=review.author.username%></b></i>
          <p class="starability-result" data-rating="<%=review.rating%>">
          </p>
          <!-- Comment -->
          <p style="font-size:14px; color:#444; line-height:1.6; margin:0;">
            <%= review.comment %>
          </p>
          <form method="post" action="/listing/<%=listing._id%>/reviews/<%=review._id%>?_method=Delete">
            <button type="submit" class="btn-delete-review">
              <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" fill="currentColor" viewBox="0 0 16 16">
                <path d="M5.5 5.5A.5.5 0 0 1 6 6v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5zm2.5 0a.5.5 0 0 1 .5.5v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5zm3 .5a.5.5 0 0 0-1 0v6a.5.5 0 0 0 1 0V6z"/>
                <path fill-rule="evenodd" d="M14.5 3a1 1 0 0 1-1 1H13v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4h-.5a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1H6a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1h3.5a1 1 0 0 1 1 1v1zM4.118 4 4 4.059V13a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V4.059L11.882 4H4.118zM2.5 3V2h11v1h-11z"/>
              </svg>
              Delete Review
            </button>
          </form>

        </div>
        <% } %>
      </div>
    </div>
  </div>
  <%}%>
  <div class="col-8 offset-3 mb-3">
    <h3>Where Youll be</h3>
    <div id="map"></div>
  </div>




<style>
  .review-card {
    background: #fff;
    border: 1px solid #e8e8e8;
    border-radius: 12px;
    padding: 1.25rem;
    transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
    cursor: default;
  }

  .review-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08);
    border-color: #E8A020;
  }
</style>

<script>
  document.querySelector('.needs-validation').addEventListener('submit', function(event) {
    const ratingSelected = this.querySelector('input[name="review[rating]"]:checked');
    const ratingError = document.getElementById('ratingError');
    const formValid = this.checkValidity();

    if (!ratingSelected) {
      ratingError.style.display = 'block';
      event.preventDefault();
      event.stopPropagation();
    }

    if (!formValid) {
      event.preventDefault();
      event.stopPropagation();
    }

    this.classList.add('was-validated');
  });
</script>
<script src="/javascript/map.js"></script>